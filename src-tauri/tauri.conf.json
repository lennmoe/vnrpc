{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VisualNovelRPC",
  "version": "2.0.0",
  "identifier": "moe.lenn.vnrpc-tauri",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Visual Novel RPC",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "visible": false,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://*.vndb.org https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
